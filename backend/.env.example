# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=dev                      # dev | staging | prod
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=dev-only-change-me-please-32chars-min
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Base de datos ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://quinta:quinta@localhost:5432/quinta
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_STATEMENT_TIMEOUT_MS=8000

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Pagos ──────────────────────────────────────────────────────────────────────
PAYMENTS_GATEWAY=stripe              # stripe | mercadopago
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_COUNTRY=MX
PLATFORM_FEE_BPS=750                 # 7.5% de comisión de servicio
MERCADOPAGO_ACCESS_TOKEN=

# ── Archivos (S3 / Cloudflare R2) ──────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_BUCKET=quinta-media
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_PUBLIC_BASE_URL=http://localhost:9000/quinta-media
PRESIGN_TTL_SECONDS=900

# ── Mapas ──────────────────────────────────────────────────────────────────────
MAPS_PROVIDER=mapbox                 # mapbox | google
MAPBOX_ACCESS_TOKEN=pk.xxx
GEOCODING_TIMEOUT_SECONDS=4

# ── Correo / OTP / push ────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025                       # Mailhog
SMTP_FROM=hola@quinta.mx
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
EXPO_PUSH_ENABLED=true

# ── Reglas de negocio ──────────────────────────────────────────────────────────
HOLD_TTL_SECONDS=900                 # 15 min para pagar
HOLD_MAX_ACTIVE_PER_USER=3
CLEANING_BUFFER_MINUTES=60
CANCEL_FULL_REFUND_DAYS=30
CANCEL_HALF_REFUND_DAYS=7
SEARCH_MAX_RADIUS_KM=120
SEARCH_DEFAULT_RADIUS_KM=25
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_HOLD=10/minute
RATE_LIMIT_OTP=5/hour

# ── Webhooks salientes ─────────────────────────────────────────────────────────
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_SECONDS=8
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

# ── Retención / cumplimiento ───────────────────────────────────────────────────
DATA_RETENTION_INVOICE_YEARS=5
AUDIT_RETENTION_DAYS=730
TOS_VERSION=2026-01-15
